{
  "name": "@7resp4ss/pi-sandbox",
  "version": "0.1.1",
  "description": "Capability-aware sandbox extension for pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "sandbox",
    "security",
    "filesystem",
    "process",
    "network",
    "developer-tools",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/7resp4ss/pi-sandbox.git"
  },
  "homepage": "https://github.com/7resp4ss/pi-sandbox#readme",
  "bugs": {
    "url": "https://github.com/7resp4ss/pi-sandbox/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.76"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
